{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "experimental": {
    "subagent_depth": 0
  },
  "websearch": {
    "provider": "random",
  },
  "permissions": [
    { "action": "*", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "deny" },
    { "action": "external_directory", "resource": "*", "effect": "ask" }
  ]
}
